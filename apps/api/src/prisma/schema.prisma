generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
  engineType      = "binary"
  binaryTargets   = ["native", "linux-musl-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OAuthProvider {
  id               Int    @id @default(autoincrement())
  name             String @unique
  clientId         String
  clientSecret     String
  authorizationUrl String
  tokenUrl         String
  userInfoUrl      String
  redirectUri      String
  scope            String
}

model SAMLProvider {
  id           Int    @id @default(autoincrement())
  name         String @unique
  entryPoint   String
  issuer       String
  cert         String
  ssoLoginUrl  String
  ssoLogoutUrl String
  audience     String
  recipient    String
  destination  String
  acsUrl       String
}

model openIdConfig {
  id          Int    @id @default(autoincrement())
  clientId    String
  issuer      String
  redirectUri String
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  userAgent    String?
  ipAddress    String?
  apiKey       Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id     String @id @default(cuid())
  code   String @unique
  userId String
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions Json[]
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  users       User[]
}

model User {
  id                           String    @id @default(uuid())
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @default(now())
  name                         String
  password                     String?
  email                        String    @unique
  image                        String?
  emailVerified                Boolean?
  isAdmin                      Boolean   @default(false)
  language                     String?   @default("en")
  notify_ticket_created        Boolean   @default(true)
  notify_ticket_status_changed Boolean   @default(true)
  notify_ticket_comments       Boolean   @default(true)
  notify_ticket_assigned       Boolean   @default(true)
  firstLogin                   Boolean   @default(true)
  external_user                Boolean   @default(false)
  out_of_office                Boolean   @default(false)
  out_of_office_message        String?
  out_of_office_start          DateTime?
  out_of_office_end            DateTime?

  todos         Todos[]
  tickets       Ticket[]
  file          UserFile[]
  notes         Notes[]
  Team          Team?           @relation(fields: [teamId], references: [id])
  teamId        String?
  Comment       Comment[]
  Session       Session[]
  TimeTracking  TimeTracking[]
  notifications notifications[]
  TicketFile    TicketFile[]
  roles         Role[]
  apiKeys       ApiKey[]
}

model Team {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  name      String

  members User[]
  Ticket  Ticket[]
}

model Ticket {
  id         String       @id @default(uuid())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())
  name       String?
  title      String
  detail     String?
  email      String?
  note       String?
  isComplete Boolean
  priority   String
  linked     Json?
  fromImap   Boolean
  Number     Int          @default(autoincrement())
  status     TicketStatus @default(needs_support)
  type       TicketType   @default(GENERAL)
  workType   String?      // e.g., "Plumbing", "Electrical", "Windows"
  hidden     Boolean      @default(false)
  createdBy  Json?
  locked     Boolean      @default(false)
  following  Json?

  maintenanceStatus MaintenanceStatus? // Maintenance workflow state (null for non-maintenance)

  // Thread Matching Fields
  threadId     String?  @unique // Gmail X-GM-THRID or root Message-ID
  externalIds  String[] // All Message-IDs associated with this ticket
  mergedIntoId String?  // If this ticket was merged into another one
  metadata     Json?    // Flexible storage for provider-specific headers

  TicketFile   TicketFile[]
  Comment      Comment[]
  TimeTracking TimeTracking[]

  team       Team?   @relation(fields: [teamId], references: [id])
  teamId     String?
  assignedTo User?   @relation(fields: [userId], references: [id])
  client     Client? @relation(fields: [clientId], references: [id])
  clientId   String?
  userId     String?

  sourceQueueId String?
  sourceQueue   EmailQueue? @relation("QueueTickets", fields: [sourceQueueId], references: [id])

  knowledgeBase knowledgeBase[]
  notifications notifications[]
}

model TimeTracking {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  title     String
  comment   String?
  time      Int

  user     User?   @relation(fields: [userId], references: [id])
  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?
  userId   String?
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id])
}

model Comment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  text       String
  public     Boolean   @default(false)
  reply      Boolean   @default(false)
  replyEmail String?
  edited     Boolean   @default(false)
  editedAt   DateTime?
  previous   String?

  // RFC 5322 Thread Matching Fields
  messageId String?  @unique // The unique Message-ID of this email/reply
  inReplyTo String?  // The Message-ID this comment is responding to

  // Sender identification for conversation context
  senderRole SenderRole @default(customer)

  userId   String?
  user     User?   @relation(fields: [userId], references: [id])
  ticketId String
  ticket   Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Client {
  id           String         @id @default(uuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now())
  name         String
  email        String         @unique
  contactName  String
  number       String?
  notes        String?
  tickets      Ticket[]
  active       Boolean        @default(true)
  TimeTracking TimeTracking[]
}

model UserFile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  filename  String
  path      String

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model TicketFile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  filename  String
  path      String
  mime      String
  encoding  String
  size      Int

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])
}

model Notes {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  title      String
  note       String
  Favourited Boolean  @default(false)

  createdBy User   @relation(fields: [userId], references: [id])
  userId    String
}

model Todos {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  text      String
  done      Boolean  @default(false)

  createdBy User   @relation(fields: [userId], references: [id])
  userId    String
}

model Webhooks {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  name      String
  url       String
  type      Hook
  active    Boolean
  secret    String?
  createdBy String
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String    // e.g., "Flowise Integration"
  key         String    @unique // SHA-256 hashed API key
  prefix      String    // First 8 chars for display (pk_abc123...)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String[]  // ["issue::read", "issue::comment"]
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime? // Optional expiration
  createdAt   DateTime  @default(now())
}

model Discord {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  name      String
  secret    String?
  url       String
  active    Boolean  @default(false)
}

model Slack {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  name      String
  secret    String?
  url       String
  active    Boolean  @default(false)
}

model Email {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  active       Boolean  @default(false)
  user         String
  pass         String?
  secure       Boolean  @default(false)
  host         String
  reply        String
  port         String
  serviceType  String   @default("other")
  clientId     String?
  clientSecret String?
  tenantId     String?
  refreshToken String?
  accessToken  String?
  expiresIn    BigInt?
  redirectUri  String?
}

model Config {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  notifications    Json? // Array of service names and an active field of TRUE OR FALSE
  sso_provider     String?
  sso_active       Boolean @default(false)
  gh_version       String?
  client_version   String?
  feature_previews Boolean @default(false)
  roles_active     Boolean @default(false)

  encryption_key   Bytes?
  first_time_setup Boolean @default(true)
}

model Uptime {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  name    String
  url     String
  active  Boolean  @default(false)
  webhook String?
  latency Int?
  status  Boolean?
}

model knowledgeBase {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  title   String
  content String
  tags    String[]
  author  String
  public  Boolean  @default(false)

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id])
}

model Imap_Email {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  from    String?
  subject String?
  body    String?
  text    String?
  html    String?

  EmailQueue   EmailQueue? @relation(fields: [emailQueueId], references: [id])
  emailQueueId String?
}

model EmailQueue {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  name         String
  username     String
  password     String?
  hostname     String
  tls          Boolean @default(true)
  active       Boolean @default(true)
  teams        Json?
  serviceType  String  @default("other")
  clientId     String?
  clientSecret String?
  tenantId     String?
  refreshToken String?
  accessToken  String?
  expiresIn    BigInt?
  redirectUri  String?

  imap    Imap_Email[]
  tickets Ticket[]     @relation("QueueTickets")
}

model notifications {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  read Boolean @default(false)
  text String

  user     User    @relation(fields: [userId], references: [id])
  userId   String
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id])
}

model emailTemplate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  html String
  type Template
}

enum SenderRole {
  customer
  vendor
  ai
  agent
}

enum Hook {
  ticket_created
  ticket_status_changed
  customer_ticket_created
  ticket_reply_received
  invoice_received
}

enum TicketStatus {
  hold
  needs_support
  in_progress
  in_review
  done
}

enum TicketType {
  GENERAL
  MAINTENANCE_ORDER
  COMPLAINT
  INFORMATION_INQUIRY
  CANCELLATION
  SPAM
  GREETING_OTHER
}

enum MaintenanceStatus {
  pending
  awaiting_tenant_info
  emergency_dispatched
  quote_sent_to_vendor
  vendor_quote_received
  awaiting_customer_approval
  customer_approved
  vendor_contacting_tenant
  appointment_request_sent
  vendor_confirmed_appointment
  customer_notified_of_appointment
  work_completed
  cancelled
}

enum Template {
  ticket_created
  ticket_status_changed
  ticket_assigned
  ticket_comment
}

model VendorCategory {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique

  vendors Vendor[]
}

model Vendor {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  email       String   @unique
  categoryId  String
  category    VendorCategory @relation(fields: [categoryId], references: [id])
  description String   // Required for AI matching
  active      Boolean  @default(true)

  invoices    Invoice[]
}

model UtilityCategory {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique

  utilities UtilityCompany[]
}

model UtilityCompany {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  email       String   @unique
  categoryId  String
  category    UtilityCategory @relation(fields: [categoryId], references: [id])
  description String
  active      Boolean  @default(true)

  invoices    Invoice[]
}

model GLAccount {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  code             String   @unique    // 4-5 digit, e.g. "60000", "4000", "80010"
  name             String              // e.g. "Mieten Wohnraum", "Heizkosten Gas"
  accountClass     String              // Group code, e.g. "6000", "8000", "0000"
  accountClassName String              // Group name, e.g. "Erträge", "Aufwendungen"
  taxCode          String              // e.g. "M19", "kein", "M7", "19,0"
  taxRate          Float               // e.g. 19.00, 0.00, 7.00
  active           Boolean  @default(true)

  invoiceItems     InvoiceItem[]
}

// ==========================================
// UC3 Phase 2: Invoice Data Layer
// ==========================================

model Invoice {
  id                     String    @id @default(uuid())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Core fields
  invoiceNumber          String
  invoiceDate            DateTime
  dueDate                DateTime?

  // Amounts
  grossTotal             Float
  netTotal               Float?
  vatAmount              Float?
  vatRate                Float?
  taxType                String    @default("vat")  // "vat" or "insurance_tax"

  // Labor/Material split (§35a)
  laborTotal             Float?
  laborTotalGross        Float?
  materialTotal          Float?

  // Property/Owner identification
  propertyAddress        String?   // Bauvorhaben / Versichertes Objekt
  propertyOwner          String?   // Rechnungsempfänger owner name
  tenantName             String?
  unitReference          String?   // Floor/unit e.g. "2.OG mitte"

  // Skonto (discount)
  skontoRate             Float?
  skontoAmount           Float?
  skontoDeadline         DateTime?

  // Vendor reference numbers
  vendorCustomerNumber   String?
  vendorProjectNumber    String?
  vendorTaxNumber        String?

  // Insurance-specific
  insurancePolicyNumber  String?
  coveragePeriod         String?

  // Utility-specific
  contractAccountNumber  String?
  meterNumber            String?
  billingPeriodStart     DateTime?
  billingPeriodEnd       DateTime?

  // PDF storage (nullable for now)
  pdfPath                String?

  // Status & workflow
  status                 String    @default("pending_review")  // pending_review, approved, exported
  aiConfidence           Float?
  sourceType             String    @default("standalone")      // standalone, maintenance_linked
  caseNumber             String?                               // UC2 ticket ref

  // Relations
  vendorId               String?
  vendor                 Vendor?   @relation(fields: [vendorId], references: [id])
  utilityCompanyId       String?
  utilityCompany         UtilityCompany? @relation(fields: [utilityCompanyId], references: [id])

  items                  InvoiceItem[]
}

model InvoiceItem {
  id                     String    @id @default(uuid())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  description            String
  unit                   String?   // Stück, Std, m², x
  quantity               Float?
  unitPrice              Float?
  total                  Float
  costType               String?   // labor, material, mixed

  // GL Account
  glAccountId            String?
  glAccount              GLAccount? @relation(fields: [glAccountId], references: [id])
  glAccountSuggested     String?   // AI suggestion before human review

  // Parent invoice
  invoiceId              String
  invoice                Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ==========================================
// DOMUS1000 Data Import
// ==========================================

model DomusUnit {
  id                   String    @id @default(uuid())
  createdAt            DateTime  @default(now())

  // Identifiers
  propertyNumber       String
  unitNumber           String
  propertyDescription  String?
  searchTerm           String?
  addressNumber        String?
  tenantOwnerNumber    String?
  d130Number           String?

  // Address
  address              String?
  street               String?
  poBox                String?
  postalCode           String?
  city                 String?
  country              String?

  // Names
  salutation1          String?
  name1                String?
  salutation2          String?
  name2                String?
  name3                String?
  name4                String?

  // Contact
  phonePrivate         String?
  phonePrivate2        String?
  phoneBusiness        String?
  phoneBusiness2       String?
  fax                  String?
  mobile               String?
  mobile2              String?
  email                String?
  email2               String?
  homepage             String?

  // Unit Details
  sector               String?
  unitDescription      String?
  equipment            String?
  taxNumber            String?
  taxExemptionDate     DateTime?
  totalGrossRent       Float?

  // Lease
  moveInDate           DateTime?
  moveOutDate          DateTime?

  // Additional
  additional1          String?
  additional2          String?
  additional3          String?

  // Direct Debit
  directDebitActive    Boolean?
  directDebitFrom      DateTime?
  directDebitUntil     DateTime?
  directDebitDay       Int?

  // SEPA
  mandateReference     String?
  mandateValidFrom     DateTime?
  mandateValidUntil    DateTime?
  formDate             DateTime?

  // Foreign Address
  foreignAddressActive Boolean?
  addressLine1         String?
  addressLine2         String?
  addressLine3         String?
  addressLine4         String?

  // Relations
  bankingInfo          DomusBankingInfo?
  allocationKeys       DomusAllocationKey[]
  scheduledCharges     DomusScheduledCharge[]

  @@index([propertyNumber, unitNumber])
}

model DomusBankingInfo {
  id                       String    @id @default(uuid())
  unitId                   String    @unique
  unit                     DomusUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  // Tenant/Owner Bank
  bankName                 String?
  bankCode                 String?
  accountNumber            String?
  bic                      String?
  iban                     String?
  accountHolder            String?

  // Property Bank
  propertyBank             String?
  propertyBankCode         String?
  propertyBankAccount      String?
  propertyBankHolder       String?
  propertyBankBic          String?
  propertyBankIban         String?
  propertyBankCreditorName String?
  propertyBankCreditorId   String?

  // Tenant LEV Bank
  tenantLevBank            String?
  tenantLevBankCode        String?
  tenantLevBankAccount     String?
  tenantLevBankHolder      String?
  tenantLevBankBic         String?
  tenantLevBankIban        String?
  tenantLevCreditorName    String?
  tenantLevCreditorId      String?
}

model DomusAllocationKey {
  id              String    @id @default(uuid())
  unitId          String
  unit            DomusUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  keyIndex        Int
  keyDescription  String?
  totalValue      Float?
  keyType         String?
  explanation     String?
  keyValue        Float?
  meterReadingNew Float?
  meterReadingOld Float?
  readingDate     DateTime?
  variableValue   Float?

  @@index([unitId])
}

model DomusScheduledCharge {
  id            String    @id @default(uuid())
  unitId        String
  unit          DomusUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  chargeIndex   Int
  d015Number    String?
  chargeText    String?
  paymentMethod String?
  month         String?
  d210Number    String?
  chargeType    String?
  amount        Float?

  @@index([unitId])
}

model DomusJob {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  status          String    @default("QUEUED")
  filename        String
  fileSizeBytes   Int

  totalRows       Int       @default(0)
  processedRows   Int       @default(0)
  skippedRows     Int       @default(0)

  errorMessage    String?
  skippedDetails  Json?

  uploadedById    String?

  @@index([status])
}

model DomusConfig {
  id                    String    @id @default(uuid())
  lastUploadedFilename  String?
  lastFileUploadedAt    DateTime?
  updatedAt             DateTime  @updatedAt
}
